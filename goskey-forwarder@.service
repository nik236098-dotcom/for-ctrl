[Unit]
Description=Goskey document forwarder (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# TODO: укажите реальный путь после клонирования репозитория на VDS
WorkingDirectory=/opt/goskey-forwarder
ExecStart=/opt/goskey-forwarder/venv/bin/python -m bot.poller --env .env.%i
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
