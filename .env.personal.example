# Настройки для ЛИЧНОГО аккаунта Госключ.
# Скопируйте в .env.personal и заполните. Не должен попадать в git.

# Как подписывать документы этого аккаунта в сообщениях Telegram
ACCOUNT_LABEL=Личный

# Токен бота от @BotFather (можно один и тот же бот для обоих аккаунтов)
TELEGRAM_BOT_TOKEN=

# ID чата, куда слать документы этого аккаунта
TELEGRAM_CHAT_ID=

# Адрес ADB — порт должен совпадать с ADB_HOST_PORT_PERSONAL из .env (docker-compose)
ADB_DEVICE=127.0.0.1:5555

# Как часто проверять новые документы, секунд
POLL_INTERVAL_SECONDS=300

# --- Пути к данным этого аккаунта ---
# Можно не задавать: по умолчанию всё уйдёт в data/personal/ и downloads/personal/
# автоматически (на основе имени файла .env.personal), не пересекаясь со вторым аккаунтом.
# DOWNLOAD_DIR=./downloads/personal
# SEEN_DOCS_FILE=./data/personal/seen_docs.json
# LOGIN_ALERT_STATE_FILE=./data/personal/login_alert_state.json
# TELEGRAM_OFFSET_FILE=./data/personal/telegram_offset.json

# --- Восстановление сессии без scrcpy (см. README) ---
GOSKEY_LOGIN=
GOSKEY_PASSWORD=
OTP_WAIT_TIMEOUT_SECONDS=600
LOGIN_ALERT_COOLDOWN_HOURS=6
