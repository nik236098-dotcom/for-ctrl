# Настройки для аккаунта ИП в Госключ.
# Скопируйте в .env.ip и заполните. Не должен попадать в git.

ACCOUNT_LABEL=ИП

# Токен бота от @BotFather (можно тот же бот, что и для личного аккаунта)
TELEGRAM_BOT_TOKEN=

# ID чата, куда слать документы этого аккаунта (можно тот же чат — сообщения
# всё равно будут помечены [ИП] / [Личный], см. ACCOUNT_LABEL)
TELEGRAM_CHAT_ID=

# Адрес ADB — порт должен совпадать с ADB_HOST_PORT_IP из .env (docker-compose)
ADB_DEVICE=127.0.0.1:5565

POLL_INTERVAL_SECONDS=300

# --- Пути к данным этого аккаунта ---
# По умолчанию уйдёт в data/ip/ и downloads/ip/ — раскомментируйте, если
# нужно переопределить.
# DOWNLOAD_DIR=./downloads/ip
# SEEN_DOCS_FILE=./data/ip/seen_docs.json
# LOGIN_ALERT_STATE_FILE=./data/ip/login_alert_state.json
# TELEGRAM_OFFSET_FILE=./data/ip/telegram_offset.json

# --- Восстановление сессии без scrcpy (см. README) ---
GOSKEY_LOGIN=
GOSKEY_PASSWORD=
OTP_WAIT_TIMEOUT_SECONDS=600
LOGIN_ALERT_COOLDOWN_HOURS=6
