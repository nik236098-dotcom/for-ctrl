# Настройки уровня Docker (порты контейнеров). Скопируйте в .env — этот
# файл docker-compose подхватывает автоматически, ничего дополнительно
# указывать не нужно. Это ОТДЕЛЬНЫЙ файл от .env.personal / .env.ip —
# тут только то, что нужно docker-compose, а не Python-скрипту.

# Порт на хосте для ADB личного аккаунта
ADB_HOST_PORT_PERSONAL=5555

# Порт на хосте для ADB аккаунта ИП
# Если 5555/5565 чем-то заняты на сервере (см. scripts/check_prereqs.sh) —
# смените здесь на свободные.
ADB_HOST_PORT_IP=5565
