# Скопируйте в .env и заполните. .env не должен попадать в git.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата, куда слать документы (свой личный chat_id, см. README п.6)
TELEGRAM_CHAT_ID=

# Порт на хосте, через который наружу торчит ADB контейнера redroid.
# Если на сервере уже что-то занимает 5555 (например, чужой проект) — смените тут.
ADB_HOST_PORT=5555

# Адрес ADB для подключения — порт должен совпадать с ADB_HOST_PORT выше
ADB_DEVICE=127.0.0.1:5555

# Как часто проверять новые документы, секунд
POLL_INTERVAL_SECONDS=300

# Куда временно скачивать PDF перед отправкой в Telegram
DOWNLOAD_DIR=./downloads

# Где хранится список уже отправленных документов (чтобы не дублировать)
SEEN_DOCS_FILE=./data/seen_docs.json

# --- Восстановление сессии без scrcpy ---

# Опционально: логин/пароль от Госключ. Если заданы — бот сам заполнит
# форму входа, когда сессия слетит. Код из SMS это НЕ обходит — его
# всё равно нужно будет прислать в Telegram, когда бот попросит (SIM
# ведь всегда под рукой).
GOSKEY_LOGIN=
GOSKEY_PASSWORD=

# Сколько ждать ваш ответ с кодом из SMS в Telegram, секунд
OTP_WAIT_TIMEOUT_SECONDS=600

# Файл, где бот хранит offset последнего обработанного сообщения Telegram
# (чтобы не путать код из SMS со старыми сообщениями после перезапуска)
TELEGRAM_OFFSET_FILE=./data/telegram_offset.json

# Через сколько часов повторить предупреждение "нужен ручной вход",
# если автоматическое восстановление не удалось
LOGIN_ALERT_COOLDOWN_HOURS=6
