<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RuVPN" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Кнопки-«таблички»: плоские, с чернильной обводкой, без теней. -->
    <style name="Widget.RuVPN.Button.Flat" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/pt_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/card</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/hairline</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
