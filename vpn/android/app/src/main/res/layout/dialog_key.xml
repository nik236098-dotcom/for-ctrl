<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_bold"
        android:gravity="center"
        android:text="@string/key_dialog_title"
        android:textColor="@color/ink"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:gravity="center"
        android:text="@string/key_dialog_help"
        android:textColor="@color/ink_soft"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input_box"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:gravity="top|start"
        android:hint="@string/key_dialog_hint"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="16dp"
        android:textColor="@color/cyan"
        android:textColorHint="@color/ink_soft"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPasteClipboard"
        style="@style/Widget.RuVPN.Button.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/paste_from_clipboard" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:gravity="start|center_vertical"
            android:minHeight="48dp"
            android:text="@string/cancel"
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:gravity="end|center_vertical"
            android:minHeight="48dp"
            android:text="@string/done"
            android:textColor="@color/cyan"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
