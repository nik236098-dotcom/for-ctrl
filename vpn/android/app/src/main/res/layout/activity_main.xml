<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kelly_slab"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pt_sans"
            android:letterSpacing="0.04"
            android:text="@string/subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <!-- Будка и герой: окно горит и герой улыбается, когда связь есть. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageBooth"
                android:layout_width="96dp"
                android:layout_height="134dp"
                android:contentDescription="@null"
                android:src="@drawable/booth_off" />

            <ImageView
                android:id="@+id/imageHero"
                android:layout_width="118dp"
                android:layout_height="148dp"
                android:layout_marginStart="-6dp"
                android:contentDescription="@string/hero_description"
                android:src="@drawable/hero_off" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ink"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kelly_slab"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/red"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/textServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/pt_sans"
                    android:text="@string/server_none"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textKeyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pt_sans"
                    android:text="@string/key_missing"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <TextView
                    android:id="@+id/textTraffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pt_sans"
                    android:text="@string/traffic_idle"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Главная кнопка: большая, круглая, с ободком. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <View
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToggle"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:fontFamily="@font/kelly_slab"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@color/paper"
                android:textSize="21sp"
                app:backgroundTint="@color/orange"
                app:cornerRadius="84dp"
                app:elevation="0dp"
                app:strokeColor="@color/ink"
                app:strokeWidth="3dp" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/ink_soft"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCheckIp"
            style="@style/Widget.RuVPN.Button.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/check_ip" />

        <TextView
            android:id="@+id/textIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pt_sans"
            android:gravity="center"
            android:text="@string/ip_unknown"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/divider_dashed"
            android:layerType="software" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonKey"
            style="@style/Widget.RuVPN.Button.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/paste_key" />

    </LinearLayout>
</ScrollView>
