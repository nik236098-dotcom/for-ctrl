<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Космический фон на весь экран, без отступов и обрезки пропорций. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/space_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- match_parent (не wrap_content!) — вместе с fillViewport на ScrollView
             это стандартный способ дать контенту, который короче экрана,
             растянуться на весь его размер (у весов ниже иначе не было бы
             реального пространства, чтобы его отвоёвывать: слишком мало
             контента на большом экране просто прилипало бы кверху). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.08"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="34sp" />

            <!-- Ваш ip: значок глобуса того же размера, что и текст, флаг
                 страны — обычный эмодзи, система рисует его сама. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageGlobe"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_globe" />

                <TextView
                    android:id="@+id/textIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:text="@string/ip_placeholder"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Растягивается на весь свободный остаток — заголовок и IP не
                 липнут к кнопке, а кнопка не липнет к верху экрана. -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Кнопка: статичный корпус, поверх него — статичное свечение
                 включённого состояния (кроссфейд по состоянию). -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imagePowerOff"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/power_button_description"
                    android:src="@drawable/power_off" />

                <ImageView
                    android:id="@+id/imagePowerOn"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:src="@drawable/power_on" />

                <View
                    android:id="@+id/buttonToggle"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:text="@string/status_disconnected"
                android:textColor="@color/ink_soft"
                android:textSize="20sp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/cyan"
                android:visibility="gone" />

            <!-- Получено / отправлено — просто текстом, без карточек. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="@string/traffic_received_label"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textReceived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:text="@string/traffic_placeholder"
                        android:textColor="@color/ink_soft"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="@string/traffic_sent_label"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textSent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:text="@string/traffic_placeholder"
                        android:textColor="@color/ink_soft"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- И второй такой же — отделяет «Получено/Отправлено» от кнопки
                 внизу, вместо того чтобы кнопка липла сразу под ними. -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonKey"
                style="@style/Widget.RuVPN.Button.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paste_key" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
