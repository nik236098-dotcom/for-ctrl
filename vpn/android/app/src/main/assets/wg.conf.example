# Пример настроек клиента. Обычно ключ вставляют прямо в приложении
# (строка ruvpn://… из бота), но если собираете APK под себя — файл,
# который выдаёт
# vpn/server/add_client.sh, положите рядом под именем wg.conf —
# тогда он попадёт внутрь APK и приложение подключится в одно нажатие
# (wg.conf добавлен в .gitignore, в репозиторий ключи не утекут).

[Interface]
PrivateKey = <приватный ключ клиента>
Address = 10.13.13.2/32
DNS = 77.88.8.8, 77.88.8.1

[Peer]
PublicKey = <публичный ключ сервера>
PresharedKey = <общий ключ>
Endpoint = <IP вашего VDS в России>:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
