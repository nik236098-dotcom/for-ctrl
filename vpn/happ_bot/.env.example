# Настройки Happ-бота. Скопируйте в .env и заполните (файл в .gitignore).
# Бот отдельный от ruvpn_bot (WireGuard) — свой токен, своя база, свой сервис.

# Токен бота от @BotFather (заводите ОТДЕЛЬНОГО бота, не тот же, что у WireGuard)
BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
ADMIN_IDS=

# С российского IP доступ к api.telegram.org иногда режется у хостера —
# тогда сюда прокси: http://user:pass@host:port или socks5://host:port.
TELEGRAM_PROXY=

# Сколько устройств (ключей Happ) разрешено одному человеку одновременно.
MAX_DEVICES=2

# Как часто проверять сроки подписки, секунд. Минимум 30.
ENFORCE_INTERVAL_SECONDS=60

# --- тарифы -----------------------------------------------------------
# «дни:рубли» через запятую — цены такие, какие видит человек в боте.
PLANS=1:60,3:150,7:250,30:450

# --- оплата: CryptoBot --------------------------------------------------
# Токен приложения: @CryptoBot → Crypto Pay → Create App.
# Пусто — этот способ оплаты не показывается.
CRYPTO_PAY_TOKEN=

# 1 — тестовая сеть (@CryptoTestnetBot, деньги ненастоящие), 0 — боевой @CryptoBot.
CRYPTO_PAY_TESTNET=1

# --- оплата: xRocket Pay ------------------------------------------------
# Токен: https://t.me/xRocket → Pay App → Create App.
# Пусто — этот способ оплаты не показывается.
XROCKET_API_TOKEN=

# xRocket не умеет фиатные счета — рублёвую цену тарифа переводим в этот
# крипто-актив перед выставлением счёта.
XROCKET_CURRENCY=USDT

# Запасной курс USDT/RUB для xRocket-счетов — используется, только если не
# получилось спросить живой курс у CoinGecko в момент выставления счёта
# (CryptoBot конвертирует сам, тут только для xRocket). Подправляйте
# изредка вручную под актуальный курс, чтобы запасной вариант не был
# слишком старым.
RUB_PER_USDT=95

# --- пути (обычно менять не нужно) -------------------------------------
# Папка со скриптами vpn/server (add_client_happ.sh и т.д.) — бот
# запускается на ТОМ ЖЕ сервере, где живёт Xray (см. install_xray.sh),
# поэтому команды — через локальный sudo, без SSH.
SCRIPTS_DIR=/opt/happ-vpn/server
DB_PATH=/var/lib/happ-vpn-bot/bot.db
