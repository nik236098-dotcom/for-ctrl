<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    Запрос прав администратора для всего приложения целиком.

    Зачем: приложение ставит/снимает системный сервис туннеля через
    `wireguard.exe /installtunnelservice` — это можно сделать только от
    администратора. Проще и честнее один раз спросить права при запуске
    всего приложения (как и делает сам официальный WireGuard for Windows),
    чем городить отдельный привилегированный сервис-помощник.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="ru.forctrl.ruvpn" version="1.0.0.0" processorArchitecture="*" />
  <!--
      Без этого блока Windows грузит старую (несовместимую) comctl32.dll,
      которая не экспортирует TaskDialogIndirect — реальная ошибка, пойманная
      на установке: "Точка входа в процедуру TaskDialogIndirect не найдена".
      Свой манифест целиком заменяет манифест по умолчанию, который
      тулчейн Tauri обычно вписывает сам — поэтому этот стандартный блок
      нужно прописать здесь руками, а не только requireAdministrator.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 и 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
