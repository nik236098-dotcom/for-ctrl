# Настройки VPN-бота. Скопируйте в .env и заполните (файл в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
ADMIN_IDS=

# С российского IP доступ к api.telegram.org у некоторых хостеров режется —
# бот запускается и висит в «Start polling», а обновления не доходят.
# Тогда сюда прокси: http://user:pass@host:port или socks5://host:port.
# Пусто — работаем напрямую (по умолчанию для серверов не в России).
TELEGRAM_PROXY=

# --- доступ ----------------------------------------------------------
# Бесплатный пробный период при регистрации, дней. 0 — только за деньги.
TRIAL_DAYS=3

# 1 — вход только по инвайт-кодам (/invite), 0 — открытая регистрация.
INVITE_ONLY=0

# Сколько ключей разрешено одному человеку
MAX_DEVICES=2

# Как часто проверять сроки, секунд. По истечении срока ключи выключаются
# в течение этого времени, так что чем меньше — тем строже. Минимум 30.
ENFORCE_INTERVAL_SECONDS=60

# --- оплата через @CryptoBot -----------------------------------------
# Токен приложения: @CryptoBot → Crypto Pay → Create App.
# Пусто — оплата выключена, срок продлевает админ командой /extend.
CRYPTO_PAY_TOKEN=

# Тарифы: «дней:сумма» через запятую
PLANS=30:1,90:2.5,180:4.5

# Валюта счетов (USDT, TON, BTC…)
PRICE_ASSET=USDT

# 1 — тестовая сеть: счета выставляет @CryptoTestnetBot, деньги ненастоящие.
# Для боевого режима поставьте 0 и возьмите токен в обычном @CryptoBot.
CRYPTO_PAY_TESTNET=1

# Ссылка на APK — бот приложит её к ключу, чтобы человеку было куда его вставить.
APK_URL=https://github.com/nik236098-dotcom/for-ctrl/releases/download/ruvpn-latest/ruvpn-debug.apk

# --- сервер ключей -----------------------------------------------------
# Ключ пользователю теперь выдаётся короткий (8 букв/цифр) — сам конфиг
# тунеля лежит здесь и отдаётся приложению по этому коду через HTTP.
# Порт должен быть открыт наружу (тот же сервер, что и WireGuard).
# Адрес сервера прописывается один раз при сборке APK — см. KEY_SERVER_URL
# в vpn/README.md.
KEY_SERVER_HOST=0.0.0.0
KEY_SERVER_PORT=8081

# --- пути (обычно менять не нужно) -----------------------------------
SCRIPTS_DIR=/opt/ruvpn/server
DB_PATH=/var/lib/ruvpn-bot/bot.db
WG_IFACE=wg0

# Через сколько минут удалить из чата сообщение с ключом. 0 — не удалять.
CONFIG_MESSAGE_TTL_MINUTES=0

# --- второй сервер (США) — смена страны в приложении ------------------
# Пусто — второго сервера нет, в приложении доступна только Россия (кнопка
# «США» ответит ошибкой). Тот же короткий ключ, что уже выдан, при выборе
# США заводится там лениво — второй ключ вводить не нужно.
#
# На US-сервере должны быть: свой WireGuard (install_wireguard.sh) и та же
# папка vpn/server, что и здесь (в SCRIPTS_DIR) — но без самого бота: им
# управляют по SSH ровно теми же командами, что локальный sudo (см.
# install_bot.sh — там же нужно завести отдельного пользователя,
# добавить его публичный ключ в его ~/.ssh/authorized_keys и настроить
# ему через sudoers ровно те же шесть команд, только с этим SSH-пользователем
# вместо ruvpnbot).
US_SSH_HOST=
US_SSH_PORT=22
US_SSH_USER=root
US_SSH_KEY_PATH=/opt/ruvpn/bot/us_server_key
US_SCRIPTS_DIR=/opt/ruvpn/server
US_WG_IFACE=wg0
