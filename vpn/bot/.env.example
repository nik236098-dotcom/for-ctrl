# Настройки телеграм-бота, который выдаёт ключи доступа.
# Скопируйте в vpn/bot/.env и заполните (файл в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: напишите @userinfobot). Через запятую, если
# админов несколько. Админы не тратят инвайты и видят команды управления.
ADMIN_IDS=

# Сколько дней действует доступ после выдачи или продления
SUB_DAYS=30

# Сколько устройств разрешено одному человеку
MAX_DEVICES=2

# --- оплата через @CryptoBot (необязательно) -------------------------
# Токен приложения из @CryptoBot → Crypto Pay → Create App.
# Пусто — оплата отключена, доступ продлевает админ командой /extend.
CRYPTO_PAY_TOKEN=
# Сумма и актив за один период подписки
PRICE_AMOUNT=1
PRICE_ASSET=USDT
# Тестовая сеть Crypto Pay (@CryptoTestnetBot): 1 — да, 0 — боевая
CRYPTO_PAY_TESTNET=0

# --- пути (обычно менять не нужно) -----------------------------------
SCRIPTS_DIR=/opt/ruvpn/server
DB_PATH=/var/lib/ruvpn-bot/bot.db
WG_IFACE=wg0

# Через сколько минут бот удалит сообщение с конфигом из чата.
# 0 — не удалять. В конфиге лежит приватный ключ, поэтому в общем
# случае лучше удалять — но тогда успейте его импортировать.
CONFIG_MESSAGE_TTL_MINUTES=0
