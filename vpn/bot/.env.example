# Настройки VPN-бота. Скопируйте в .env и заполните (файл в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
ADMIN_IDS=

# --- доступ ----------------------------------------------------------
# Бесплатный пробный период при регистрации, дней. 0 — только за деньги.
TRIAL_DAYS=3

# 1 — вход только по инвайт-кодам (/invite), 0 — открытая регистрация.
INVITE_ONLY=0

# Сколько ключей разрешено одному человеку
MAX_DEVICES=2

# Как часто проверять сроки, секунд. По истечении срока ключи выключаются
# в течение этого времени, так что чем меньше — тем строже. Минимум 30.
ENFORCE_INTERVAL_SECONDS=60

# --- оплата через @CryptoBot -----------------------------------------
# Токен приложения: @CryptoBot → Crypto Pay → Create App.
# Пусто — оплата выключена, срок продлевает админ командой /extend.
CRYPTO_PAY_TOKEN=

# Тарифы: «дней:сумма» через запятую
PLANS=30:1,90:2.5,180:4.5

# Валюта счетов (USDT, TON, BTC…)
PRICE_ASSET=USDT

# 1 — тестовая сеть: счета выставляет @CryptoTestnetBot, деньги ненастоящие.
# Для боевого режима поставьте 0 и возьмите токен в обычном @CryptoBot.
CRYPTO_PAY_TESTNET=1

# --- пути (обычно менять не нужно) -----------------------------------
SCRIPTS_DIR=/opt/ruvpn/server
DB_PATH=/var/lib/ruvpn-bot/bot.db
WG_IFACE=wg0

# Через сколько минут удалить из чата сообщение с ключом. 0 — не удалять.
CONFIG_MESSAGE_TTL_MINUTES=0
